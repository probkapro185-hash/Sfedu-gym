# Скопируйте в .env и заполните реальными значениями

APP_ENV=development
HTTP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://sfedu:sfedu_secret@localhost:5432/sfedu_crm?sslmode=disable

# JWT (длинная случайная строка, минимум 32 символа)
JWT_SECRET=change_me_to_very_long_random_secret_string_here
JWT_TOKEN_TTL_HOURS=24

# Bcrypt (10-14, рекомендуется 12)
BCRYPT_COST=12

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000
